{
  "name": "sombetini-school-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Sombetini Primary School Digital Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "typecheck": "npm run typecheck --workspace=frontend && npm run typecheck --workspace=backend",
    "smoke": "node scripts/smoke-launch.mjs",
    "smoke:admin": "node scripts/ensure-smoke-admin.mjs",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:migrate:deploy": "npm run prisma:migrate:prod --workspace=backend",
    "db:seed": "npm run prisma:seed --workspace=backend",
    "db:studio": "npm run prisma:studio --workspace=backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "8.1.1",
    "@nestjs/testing": "10.4.22",
    "@nestjs/cli": "10.4.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
