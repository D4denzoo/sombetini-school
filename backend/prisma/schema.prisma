// Sombetini Primary School - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  PENDING
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  SUSPENDED
}

enum ParentLinkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementCategory {
  GENERAL
  EXAMINATION
  HOLIDAY
  PARENT_MEETING
  ACADEMIC
  EMERGENCY
  SPORTS
  CULTURAL
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  EXPIRED
}

enum EventCategory {
  EXAMINATION
  PARENT_MEETING
  SPORTS_DAY
  GRADUATION
  COMPETITION
  HOLIDAY
  CULTURAL
  STAFF_MEETING
  SCHOOL_OPENING
  SCHOOL_CLOSING
  OTHER
}

enum DocumentCategory {
  CALENDAR
  EXAM_TIMETABLE
  SCHOOL_RULES
  PARENT_GUIDELINES
  FEE_STRUCTURE
  ADMISSION
  ACADEMIC
  FORMS
  NOTICES
  OTHER
}

enum ResourceType {
  LESSON_PLAN
  TEACHING_GUIDE
  CURRICULUM
  SYLLABUS
  PAST_PAPER
  QUESTION_BANK
  TEACHING_NOTES
  PDF
  PRESENTATION
  WORKSHEET
  VIDEO
  IMAGE
  OTHER
}

enum GalleryCategory {
  CAMPUS
  CLASSROOMS
  SPORTS
  ACADEMIC_EVENTS
  GRADUATION
  SCHOOL_TRIPS
  COMPETITIONS
  TEACHERS
  STUDENTS
  OTHER
}

enum PaymentCategory {
  SCHOOL_FEES
  EXAMINATION_FEES
  UNIFORM
  TRANSPORT
  MEALS
  ACTIVITIES
  OTHER
}

enum PaymentStatus {
  PENDING
  CONTROL_NUMBER_GENERATED
  PAYMENT_INITIATED
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum MarkStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationType {
  RESULTS_AVAILABLE
  PAYMENT_REMINDER
  ANNOUNCEMENT
  EXAMINATION
  EVENT
  SECURITY_ALERT
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  ROLE_CHANGE
  MARK_ENTRY
  MARK_MODIFICATION
  RESULT_APPROVAL
  PAYMENT_GENERATED
  FILE_UPLOAD
  SETTINGS_CHANGE
}

enum TwoFactorMethod {
  TOTP
  EMAIL
  SMS
}

// ==================== RBAC ====================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== USERS & AUTH ====================

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  phone             String?
  avatarUrl         String?    @map("avatar_url")
  status            UserStatus @default(PENDING)
  emailVerified     Boolean    @default(false) @map("email_verified")
  twoFactorEnabled  Boolean    @default(false) @map("two_factor_enabled")
  twoFactorMethod   TwoFactorMethod? @map("two_factor_method")
  twoFactorSecret   String?    @map("two_factor_secret")
  loginAttempts     Int        @default(0) @map("login_attempts")
  lockedUntil       DateTime?  @map("locked_until")
  lastLoginAt       DateTime?  @map("last_login_at")
  lastLoginIp       String?    @map("last_login_ip")
  passwordChangedAt DateTime?  @map("password_changed_at")
  isDemo            Boolean    @default(false) @map("is_demo")
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  roles              UserRole[]
  parent             Parent?
  teacher            Teacher?
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  auditLogs          AuditLog[]
  announcements      Announcement[]
  markAuditLogs      MarkAuditLog[]
  resultApprovals    ResultApproval[]
  aiConversations    AiConversation[]
  submittedMarks     StudentMark[] @relation("MarkSubmitter")
  approvedMarks      StudentMark[] @relation("MarkApprover")
  otpTokens          OtpToken[]
  refreshTokens      RefreshToken[]
  reviewedParentLinks ParentStudent[] @relation("ParentLinkReviewer")

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// One row per signed-in device. Rotated on every refresh; reuse of a revoked token revokes the whole account's sessions.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model OtpToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String
  type      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@index([token])
  @@map("otp_tokens")
}

// ==================== SCHOOL SETTINGS ====================

model SchoolSettings {
  id              String   @id @default(uuid())
  schoolName      String   @map("school_name") @default("Sombetini Primary School")
  schoolNameSw    String?  @map("school_name_sw")
  motto           String?
  vision          String?  @db.Text
  mission         String?  @db.Text
  coreValues      String?  @map("core_values") @db.Text
  history         String?  @db.Text
  academicPhilosophy String? @map("academic_philosophy") @db.Text
  achievements    String?  @db.Text
  logoUrl         String?  @map("logo_url")
  primaryColor    String   @default("#1B4D3E") @map("primary_color")
  secondaryColor  String   @default("#D4A843") @map("secondary_color")
  accentColor     String   @default("#2E7D5A") @map("accent_color")
  address         String?
  postalAddress   String?  @map("postal_address")
  phone           String?
  phone2          String?
  email           String?
  emergencyPhone  String?  @map("emergency_phone")
  workingHours    String?  @map("working_hours")
  mapEmbedUrl     String?  @map("map_embed_url")
  facebookUrl     String?  @map("facebook_url")
  instagramUrl    String?  @map("instagram_url")
  youtubeUrl      String?  @map("youtube_url")
  twitterUrl      String?  @map("twitter_url")
  whatsappNumber  String?  @map("whatsapp_number")
  showFacebook    Boolean  @default(false) @map("show_facebook")
  showInstagram   Boolean  @default(false) @map("show_instagram")
  showYoutube     Boolean  @default(false) @map("show_youtube")
  showTwitter     Boolean  @default(false) @map("show_twitter")
  showWhatsapp    Boolean  @default(false) @map("show_whatsapp")
  yearsOfService  Int      @default(0) @map("years_of_service")
  isSetupComplete Boolean  @default(false) @map("is_setup_complete")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("school_settings")
}

model SchoolLeadership {
  id           String   @id @default(uuid())
  name         String
  position     String
  positionSw   String?  @map("position_sw")
  photoUrl     String?  @map("photo_url")
  welcomeMessage String? @map("welcome_message") @db.Text
  biography    String?  @db.Text
  email        String?
  phone        String?
  sortOrder    Int      @default(0) @map("sort_order")
  isHead       Boolean  @default(false) @map("is_head")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("school_leadership")
}

// ==================== ACADEMIC STRUCTURE ====================

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  terms        Term[]
  examinations Examination[]
  studentMarks StudentMark[]
  reportCards  ReportCard[]
  feeItems     FeeItem[]

  @@index([isCurrent])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  academicYearId String   @map("academic_year_id")
  name           String
  termNumber     Int      @map("term_number")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  isCurrent      Boolean  @default(false) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id])
  examinations    Examination[]
  studentMarks    StudentMark[]
  reportCards     ReportCard[]
  resultApprovals ResultApproval[]

  @@unique([academicYearId, termNumber])
  @@index([isCurrent])
  @@map("terms")
}

model Class {
  id          String   @id @default(uuid())
  name        String
  level       Int
  section     String?
  capacity    Int      @default(50)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  students          Student[]
  teacherAssignments TeacherAssignment[]
  examinations      Examination[]
  feeItems          FeeItem[]
  resultApprovals   ResultApproval[]

  @@unique([name])
  @@index([level])
  @@map("classes")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  maxMarks    Int      @default(100) @map("max_marks")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacherAssignments TeacherAssignment[]
  studentMarks       StudentMark[]
  learningResources  LearningResource[]

  @@index([code])
  @@map("subjects")
}

// ==================== PEOPLE ====================

model Parent {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  occupation     String?
  address        String?
  emergencyContact String? @map("emergency_contact")
  emergencyPhone String?  @map("emergency_phone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]
  payments Payment[]

  @@map("parents")
}

model Student {
  id               String        @id @default(uuid())
  registrationNo   String        @unique @map("registration_no")
  firstName        String        @map("first_name")
  lastName         String        @map("last_name")
  gender           Gender
  dateOfBirth      DateTime      @map("date_of_birth")
  classId          String        @map("class_id")
  status           StudentStatus @default(ACTIVE)
  admissionDate    DateTime      @map("admission_date")
  photoUrl         String?       @map("photo_url")
  address          String?
  bloodGroup       String?       @map("blood_group")
  medicalNotes     String?       @map("medical_notes")
  isDemo           Boolean       @default(false) @map("is_demo")
  deletedAt        DateTime?     @map("deleted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  class        Class           @relation(fields: [classId], references: [id])
  parents      ParentStudent[]
  marks        StudentMark[]
  reportCards  ReportCard[]
  attendance   Attendance[]
  payments     Payment[]

  @@index([registrationNo])
  @@index([classId])
  @@index([status])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("students")
}

model ParentStudent {
  parentId         String           @map("parent_id")
  studentId        String           @map("student_id")
  relationship     String           @default("parent")
  isPrimary        Boolean          @default(false) @map("is_primary")
  status           ParentLinkStatus @default(APPROVED)
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewedById     String?          @map("reviewed_by_id")
  rejectionReason  String?          @map("rejection_reason")
  createdAt        DateTime         @default(now()) @map("created_at")

  parent     Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ParentLinkReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@id([parentId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("parent_students")
}

model Teacher {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  staffNo      String   @unique @map("staff_no")
  qualification String?
  specialization String?
  joinDate     DateTime @map("join_date")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  @@index([staffNo])
  @@map("teachers")
}

model TeacherAssignment {
  id        String   @id @default(uuid())
  teacherId String   @map("teacher_id")
  classId   String   @map("class_id")
  subjectId String   @map("subject_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("teacher_assignments")
}

// ==================== EXAMINATIONS & RESULTS ====================

model Examination {
  id             String   @id @default(uuid())
  name           String
  type           String
  academicYearId String   @map("academic_year_id")
  termId         String   @map("term_id")
  classId        String?  @map("class_id")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  maxMarks       Int      @default(100) @map("max_marks")
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  term         Term          @relation(fields: [termId], references: [id])
  class        Class?        @relation(fields: [classId], references: [id])
  marks        StudentMark[]

  @@index([academicYearId, termId])
  @@index([classId])
  @@index([startDate])
  @@map("examinations")
}

model StudentMark {
  id             String     @id @default(uuid())
  studentId      String     @map("student_id")
  subjectId      String     @map("subject_id")
  examinationId  String     @map("examination_id")
  academicYearId String     @map("academic_year_id")
  termId         String     @map("term_id")
  marks          Float?
  grade          String?
  remarks        String?
  status         MarkStatus @default(DRAFT)
  submittedById  String?    @map("submitted_by_id")
  approvedById   String?    @map("approved_by_id")
  submittedAt    DateTime?  @map("submitted_at")
  approvedAt     DateTime?  @map("approved_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  student      Student     @relation(fields: [studentId], references: [id])
  subject      Subject     @relation(fields: [subjectId], references: [id])
  examination  Examination @relation(fields: [examinationId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  term         Term        @relation(fields: [termId], references: [id])
  submittedBy  User?       @relation("MarkSubmitter", fields: [submittedById], references: [id])
  approvedBy   User?       @relation("MarkApprover", fields: [approvedById], references: [id])
  auditLogs    MarkAuditLog[]

  @@unique([studentId, subjectId, examinationId])
  @@index([studentId])
  @@index([examinationId])
  @@index([status])
  @@index([academicYearId, termId])
  @@map("student_marks")
}

model MarkAuditLog {
  id            String   @id @default(uuid())
  studentMarkId String   @map("student_mark_id")
  userId        String   @map("user_id")
  action        String
  previousValue String?  @map("previous_value")
  newValue      String?  @map("new_value")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  studentMark StudentMark @relation(fields: [studentMarkId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([studentMarkId])
  @@index([userId])
  @@index([createdAt])
  @@map("mark_audit_logs")
}

model ResultApproval {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  termId    String   @map("term_id")
  status    String
  reviewedById String @map("reviewed_by_id")
  comments  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class      Class @relation(fields: [classId], references: [id])
  term       Term  @relation(fields: [termId], references: [id])
  reviewedBy User  @relation(fields: [reviewedById], references: [id])

  @@index([classId, termId])
  @@map("result_approvals")
}

model ReportCard {
  id              String   @id @default(uuid())
  studentId       String   @map("student_id")
  academicYearId  String   @map("academic_year_id")
  termId          String   @map("term_id")
  averageScore    Float?   @map("average_score")
  position        Int?
  totalStudents   Int?     @map("total_students")
  teacherComment  String?  @map("teacher_comment") @db.Text
  headComment     String?  @map("head_comment") @db.Text
  attendanceDays  Int?     @map("attendance_days")
  totalSchoolDays Int?     @map("total_school_days")
  referenceNo     String   @unique @map("reference_no")
  pdfUrl          String?  @map("pdf_url")
  isPublished     Boolean  @default(false) @map("is_published")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])

  @@unique([studentId, academicYearId, termId])
  @@index([referenceNo])
  @@index([studentId])
  @@map("report_cards")
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  date      DateTime @db.Date
  status    String
  remarks   String?
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
  @@map("attendance")
}

// ==================== PAYMENTS ====================

model FeeItem {
  id             String          @id @default(uuid())
  name           String
  description    String?
  category       PaymentCategory
  amount         Decimal         @db.Decimal(12, 2)
  classId        String?         @map("class_id")
  academicYearId String          @map("academic_year_id")
  dueDate        DateTime?       @map("due_date")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  class        Class?       @relation(fields: [classId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  payments     Payment[]

  @@index([category])
  @@index([classId])
  @@map("fee_items")
}

/// Payment integrity indexes live in SQL migrations (Prisma cannot express partial uniques):
/// - payments_one_open_per_charge: one open row per (parent, student, fee_item)
/// - payments_transaction_ref_unique: one paid receipt reference overall
/// Never `prisma db push` in production; always `migrate deploy` so those indexes stay.
model Payment {
  id              String        @id @default(uuid())
  parentId        String        @map("parent_id")
  studentId       String        @map("student_id")
  feeItemId       String        @map("fee_item_id")
  controlNumber   String?       @unique @map("control_number")
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  deadline        DateTime?
  paidAt          DateTime?     @map("paid_at")
  paymentMethod   String?       @map("payment_method")
  transactionRef  String?       @map("transaction_ref")
  gatewayResponse Json?         @map("gateway_response")
  instructions    String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  feeItem FeeItem @relation(fields: [feeItemId], references: [id])

  @@index([controlNumber])
  @@index([parentId])
  @@index([studentId])
  @@index([status])
  @@index([status, deadline])
  @@map("payments")
}

/// Every gateway callback is stored once by its provider event id so a replayed webhook cannot settle twice.
model PaymentWebhookEvent {
  id            String    @id @default(uuid())
  provider      String
  eventId       String    @map("event_id")
  controlNumber String?   @map("control_number")
  payload       Json
  receivedAt    DateTime  @default(now()) @map("received_at")
  processedAt   DateTime? @map("processed_at")
  outcome       String?

  @@unique([provider, eventId])
  @@index([controlNumber])
  @@map("payment_webhook_events")
}

// ==================== CONTENT ====================

model Announcement {
  id            String               @id @default(uuid())
  title         String
  slug          String               @unique
  description   String               @db.Text
  category      AnnouncementCategory
  status        AnnouncementStatus   @default(DRAFT)
  featuredImage String?              @map("featured_image")
  authorId      String               @map("author_id")
  publishedAt   DateTime?            @map("published_at")
  expiresAt     DateTime?            @map("expires_at")
  scheduledAt   DateTime?            @map("scheduled_at")
  isPinned      Boolean              @default(false) @map("is_pinned")
  viewCount     Int                  @default(0) @map("view_count")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  author      User                     @relation(fields: [authorId], references: [id])
  attachments AnnouncementAttachment[]

  @@index([status, publishedAt])
  @@index([category])
  @@index([slug])
  @@map("announcements")
}

model AnnouncementAttachment {
  id             String @id @default(uuid())
  announcementId String @map("announcement_id")
  fileName       String @map("file_name")
  fileUrl        String @map("file_url")
  fileSize       Int    @map("file_size")
  mimeType       String @map("mime_type")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@map("announcement_attachments")
}

model Event {
  id          String        @id @default(uuid())
  title       String
  description String?       @db.Text
  category    EventCategory
  startDate   DateTime      @map("start_date")
  endDate     DateTime?     @map("end_date")
  location    String?
  isAllDay    Boolean       @default(false) @map("is_all_day")
  isRecurring Boolean       @default(false) @map("is_recurring")
  recurrenceRule String?    @map("recurrence_rule")
  isPublished Boolean       @default(true) @map("is_published")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([startDate])
  @@index([category])
  @@index([isPublished])
  @@map("events")
}

model Document {
  id            String           @id @default(uuid())
  title         String
  description   String?
  category      DocumentCategory
  fileName      String           @map("file_name")
  fileUrl       String           @map("file_url")
  fileSize      Int              @map("file_size")
  mimeType      String           @map("mime_type")
  isPublished   Boolean          @default(true) @map("is_published")
  publishedAt   DateTime?        @map("published_at")
  downloadCount Int              @default(0) @map("download_count")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([category])
  @@index([isPublished])
  @@index([title])
  @@map("documents")
}

model LearningResource {
  id             String       @id @default(uuid())
  title          String
  description    String?
  resourceType   ResourceType @map("resource_type")
  subjectId      String?      @map("subject_id")
  classLevel     Int?         @map("class_level")
  topic          String?
  academicYear   String?      @map("academic_year")
  fileName       String?      @map("file_name")
  fileUrl        String?      @map("file_url")
  externalUrl    String?      @map("external_url")
  fileSize       Int?         @map("file_size")
  mimeType       String?      @map("mime_type")
  isPublished    Boolean      @default(true) @map("is_published")
  downloadCount  Int          @default(0) @map("download_count")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  subject Subject? @relation(fields: [subjectId], references: [id])

  @@index([resourceType])
  @@index([subjectId])
  @@index([classLevel])
  @@index([title])
  @@map("learning_resources")
}

model GalleryAlbum {
  id          String          @id @default(uuid())
  title       String
  description String?
  category    GalleryCategory
  coverUrl    String?         @map("cover_url")
  isPublished Boolean         @default(true) @map("is_published")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  images GalleryImage[]

  @@index([category])
  @@map("gallery_albums")
}

model GalleryImage {
  id        String   @id @default(uuid())
  albumId   String   @map("album_id")
  title     String?
  imageUrl  String   @map("image_url")
  thumbnailUrl String? @map("thumbnail_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@map("gallery_images")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  type      NotificationType
  title     String
  message   String             @db.Text
  data      Json?
  isRead    Boolean            @default(false) @map("is_read")
  readAt    DateTime?          @map("read_at")
  createdAt DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String              @id @default(uuid())
  userId  String              @map("user_id")
  type    NotificationType
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}

// ==================== AI ASSISTANT ====================

model AiFaq {
  id         String   @id @default(uuid())
  question   String
  questionSw String?  @map("question_sw")
  answer     String   @db.Text
  answerSw   String?  @map("answer_sw") @db.Text
  category   String?
  keywords   String?
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([category])
  @@map("ai_faqs")
}

model AiConversation {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  sessionId String   @map("session_id")
  language  String   @default("sw")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?        @relation(fields: [userId], references: [id])
  messages AiMessage[]

  @@index([sessionId])
  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

// ==================== AUDIT ====================

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  action     AuditAction
  module     String
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id")
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
