# Local next dev: API on :4000. Uploads are rewritten through Next (/uploads → API).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Canonical public site URL for sitemap, robots, and Open Graph (production: https://your-domain)
# NEXT_PUBLIC_SITE_URL=https://sombetini.ac.tz

# Optional. Server-side + /api/v1 proxy. Unset in local next (falls back to NEXT_PUBLIC_API_URL).
# Docker Compose sets: INTERNAL_API_URL=http://backend:4000
# INTERNAL_API_URL=http://localhost:4000
