# ===========================================
# Sombetini Primary School Platform
# Copy to .env and configure for your environment
# ===========================================

# Database
POSTGRES_USER=sombetini
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=sombetini_school
DATABASE_URL=postgresql://sombetini:change_me_secure_password@localhost:5432/sombetini_school?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
BACKEND_PORT=4000
# Link base for password-reset / email-verify emails. Must be the URL families actually open:
#   local next dev  → http://localhost:3000
#   Docker + nginx  → http://localhost   (or https://sombetini.ac.tz) — same as PUBLIC_API_URL
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
# Public origin browsers use to reach the site through Nginx in Docker (e.g. https://sombetini.ac.tz)
PUBLIC_API_URL=http://localhost
# Exact browser origins allowed for CORS + CSRF (comma-separated). Keep in sync with FRONTEND_URL / PUBLIC_API_URL.
CORS_ORIGINS=http://localhost:3000,http://localhost
# Production HTTPS example (replace and use the same origin in FRONTEND_URL + PUBLIC_API_URL):
# FRONTEND_URL=https://sombetini.ac.tz
# PUBLIC_API_URL=https://sombetini.ac.tz
# CORS_ORIGINS=https://sombetini.ac.tz,https://www.sombetini.ac.tz
# COOKIE_SECURE=true
# Cookie Secure flag: auto from FRONTEND_URL/PUBLIC_API_URL https://. Force with true/false if needed.
# COOKIE_SECURE=false
# Frontend container (Docker) reaches the API here; leave unset for local next dev (uses NEXT_PUBLIC_API_URL)
# INTERNAL_API_URL=http://backend:4000
# Set to 1 behind one reverse proxy (Nginx) so client IPs and rate limits are correct
TRUST_PROXY=1
# json in production for log shippers; leave empty for readable dev output
LOG_FORMAT=

# Database pool per API process (× replicas must stay under Postgres max_connections=200)
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=20

# Files
UPLOAD_DIR=./uploads
PRIVATE_FILES_DIR=./storage/private
MAX_FILE_SIZE=10485760

# Observability: set a long random token to enable GET /api/v1/metrics for Prometheus
METRICS_TOKEN=

# Housekeeping windows (days)
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_MAX_AGE_DAYS=365
AUDIT_RETENTION_DAYS=730
AI_CHAT_RETENTION_DAYS=180
WEBHOOK_RETENTION_DAYS=365

# Nginx: switch to ./docker/nginx/nginx.ssl.conf once certificates exist
NGINX_CONF=./docker/nginx/nginx.conf
BACKUP_HOUR_UTC=23

# Email (SMTP) — required for password resets and notice emails
# Example: school cPanel, Microsoft 365, or a Gmail app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sombetini.ac.tz

# SMS — set provider to beem, africastalking, or twilio (leave empty until connected)
# Beem Africa (Tanzania): SMS_PROVIDER=beem, SMS_API_KEY, SMS_API_SECRET, SMS_SENDER_ID
# Africa's Talking: SMS_PROVIDER=africastalking, SMS_API_KEY, SMS_USERNAME, SMS_SENDER_ID
# Twilio: SMS_PROVIDER=twilio, SMS_API_KEY=AccountSID, SMS_API_SECRET=AuthToken, SMS_SENDER_ID=+255...
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_USERNAME=
SMS_SENDER_ID=SOMBETINI

# AI Assistant (Msaidizi) — FAQ-first; optional LLM not wired yet (do not set OPENAI until implemented)
AI_ASSISTANT_NAME=Msaidizi wa Sombetini

# Payment gateway. mock = office records receipts by hand and nothing is ever auto-paid.
# When the school's GePG/bank merchant account exists: set the provider name, its keys, and a long random
# PAYMENT_WEBHOOK_SECRET; the gateway (or its adapter) then calls POST /api/v1/payments/webhook/<provider>
# with header x-payment-signature = HMAC-SHA256(raw body, PAYMENT_WEBHOOK_SECRET).
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 2FA
TOTP_ISSUER=Sombetini Primary School

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# The first administrator is created once from the website at /setup with the head teacher's own
# email and password. No default account exists.
